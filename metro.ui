  <property name="styleSheet">
   <string notr="true">QMainWindow { background-color: palette(window); }
QLabel { font-size: 13px; }
QCheckBox { font-size: 13px; }

QComboBox, QTextEdit {
    background-color: palette(base);
    color: palette(text);
    border: 1px solid palette(mid);
    border-radius: 6px;
    padding: 4px;
}
QComboBox QAbstractItemView {
    background-color: palette(base);
    color: palette(text);
    selection-background-color: palette(highlight);
    selection-color: palette(highlighted-text);
    border: 1px solid palette(mid);
}

QPushButton#boton_Calcular {
    background-color: #2e86de;
    color: white;
    border-radius: 6px;
    font-weight: bold;
}
QPushButton#boton_Calcular:hover { background-color: #1b6ec2; }

QPushButton#boton_Limpiar {
    background-color: palette(button);
    color: palette(button-text);
    border: 1px solid palette(mid);
    border-radius: 6px;
}
QPushButton#boton_Limpiar:hover { background-color: palette(midlight); }</string>
